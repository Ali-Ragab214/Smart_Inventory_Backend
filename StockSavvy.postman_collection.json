              "mode": "raw",
              "raw": "{\n  \"sku\": \"NEW-SKU-001\",\n  \"name\": \"New Product\",\n  \"categoryId\": \"{{category_id}}\",\n  \"cost\": 10.00,\n  \"price\": 24.99\n}"
            }
          }
        },
        {
          "name": "Import SKUs from CSV",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/sku/import", "host": ["{{base_url}}"], "path": ["sku", "import"] },
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Get All SKUs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && Array.isArray(json.data) && json.data.length > 0) {",
                  "  pm.collectionVariables.set('sku_id', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sku", "host": ["{{base_url}}"], "path": ["sku"] },
            "header": []
          }
        },
        {
          "name": "Get SKU by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sku/{{sku_id}}", "host": ["{{base_url}}"], "path": ["sku", "{{sku_id}}"] },
            "header": []
          }
        },
        {
          "name": "Update SKU",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/sku/{{sku_id}}", "host": ["{{base_url}}"], "path": ["sku", "{{sku_id}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 19.99\n}"
            }
          }
        },
        {
          "name": "Delete SKU",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/sku/{{sku_id}}", "host": ["{{base_url}}"], "path": ["sku", "{{sku_id}}"] },
            "header": []
          }
        }
      ]
    },
