      "item": [
        {
          "name": "Create SKU",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('sku_id', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/sku", "host": ["{{base_url}}"], "path": ["sku"] },
