# =====================
# PostgreSQL Database
# =====================
DB_HOST=localhost
DB_PORT=5424
DB_USERNAME=postgres
DB_PASSWORD=stocksavvy_pass
DB_NAME=smart_inventory

# =====================
# CORS Origin for Frontend
# =====================
WEB_ORIGIN=http://localhost:5173

# =====================
# SMTP Configuration
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="StockSavvy Security" <security@stocksavvy.com>

# =====================
# Vendor Email Channel
# ---------------------
# VENDOR_CHANNEL=simulated → offers are answered by the in-app simulated vendor (default).
# VENDOR_CHANNEL=email    → offers are emailed to vendor.contactEmail via SMTP and replies
#                           are received by polling the same mailbox over IMAP.
# =====================
VENDOR_CHANNEL=simulated

# IMAP credentials for the mailbox that RECEIVES vendor replies (must be the
# same account used for SMTP so replies land where we poll).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-google-app-password
IMAP_POLL_SECONDS=60

# =====================
# App
# =====================
NODE_ENV=development
PORT=3000

# =====================
# JWT
# =====================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# =====================
# Redis (BullMQ)
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379

# =====================
# Anthropic (LLM)
# =====================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =====================
# AI Gateway (optional, chat only)
# =====================
# Base URL of the ITI Student Bedrock Gateway (chat/embed under /api/v1)
AI_API_URL=http://apiaccess.iti.net.eg/api/v1
AI_API_KEY=your_ai_gateway_key_here

# =====================
# Embeddings (local)
# =====================
# Embeddings run locally via @xenova/transformers (all-MiniLM-L6-v2, 384 dims).
# No API key required. First run downloads the model (~25MB), then works offline.
